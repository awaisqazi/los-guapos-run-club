---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  {
    href: `${base}/#join`,
    emoji: '🪩',
    label: 'Join the familia',
    sub: 'Get each week’s meetup spot',
    primary: true,
  },
  {
    href: `${base}/`,
    emoji: '✨',
    label: 'Our website',
    sub: 'Runs, Guapøtivities, la familia',
  },
  {
    href: 'https://app.fireflifit.com/?referral=8HGEUYNBWF&name=Los+Guapos',
    emoji: '🔥',
    label: 'Firefli rewards',
    sub: 'Every run, walk, y workout cuenta',
    external: true,
  },
  {
    href: 'https://www.instagram.com/los._.guapos/',
    emoji: '📸',
    label: '@los._.guapos',
    sub: 'Watch the story for Saturday’s spot',
    external: true,
  },
];
---

<Layout title="Los Guapos Run Club · Links ✨🪩✨" minimal>
  <main
    class="relative flex min-h-svh flex-col items-center overflow-hidden px-5 py-10"
    style="background:
      radial-gradient(700px 420px at 50% -5%, #2a1c4d 0%, transparent 60%),
      radial-gradient(500px 300px at 90% 45%, rgba(228, 22, 212, 0.16) 0%, transparent 60%),
      radial-gradient(500px 300px at 5% 75%, rgba(123, 77, 255, 0.16) 0%, transparent 60%),
      var(--color-night);"
  >
    <div class="disco-spots"></div>
    <span class="sparkle text-xl" style="top: 6%; left: 10%">✦</span>
    <span class="sparkle text-2xl" style="top: 14%; left: 86%; animation-delay: 1.1s">✦</span>
    <span class="sparkle text-lg" style="top: 55%; left: 5%; animation-delay: 2s">✧</span>
    <span class="sparkle text-xl" style="top: 80%; left: 92%; animation-delay: 0.6s">✦</span>

    <div class="relative w-full max-w-sm text-center">
      <p class="text-6xl" aria-hidden="true">🪩</p>
      <img
        src={`${base}/assets/wordmark-slash.svg`}
        alt="Guapøs"
        width="582"
        height="144"
        class="mx-auto mt-4 w-64 drop-shadow-[0_0_40px_rgba(158,210,255,0.35)]"
      />
      <p class="neon-script mt-2 text-2xl" style="font-family: var(--font-serif-display)">Los Guapos Run Club</p>
      <p class="guapo-stamp mt-3 text-xs">✦&nbsp;Pilsen&nbsp;·&nbsp;Chicago&nbsp;✦</p>

      {/* schedule at a glance */}
      <div class="mt-6 space-y-2 text-sm text-cream/85">
        <p class="flyer-pill w-full border-cream/30">🪩 Thursdays 6:30 PM · Pilsen’s Gym</p>
        <p class="flyer-pill w-full border-cream/30">🌤️ Saturdays ~7:30 AM · spot varies</p>
      </div>

      {/* the links */}
      <nav aria-label="Links" class="mt-8 space-y-4">
        {
          links.map((l) => (
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class:list={[
                'block rounded-2xl p-4 transition-transform duration-200 hover:scale-[1.03] active:scale-95',
                l.primary
                  ? 'bg-guapo-yellow text-night shadow-[0_0_40px_rgba(255,214,10,0.3)]'
                  : 'border-2 border-cream/25 bg-night-soft/80 text-cream hover:border-cream/50',
              ]}
            >
              <span class="flex items-center gap-4 text-left">
                <span class="w-9 text-center text-2xl leading-none">{l.emoji}</span>
                <span class="grow">
                  <span class="font-display block text-lg tracking-wider uppercase" style="font-family: var(--font-display)">
                    {l.label}
                  </span>
                  <span class:list={['text-sm', l.primary ? 'text-night/70' : 'text-cream/60']}>{l.sub}</span>
                </span>
                <span class:list={['text-lg', l.primary ? 'text-night/60' : 'text-cream/40']}>→</span>
              </span>
            </a>
          ))
        }
      </nav>

      <p class="mt-10 text-xs tracking-widest text-cream/50 uppercase">
        All paces welcome · All bodies belong
      </p>
      <p lang="es" class="mt-2 font-serif-display text-lg italic text-cream/60" style="font-family: var(--font-serif-display)">
        Love, Los._.Guapos ✨💖✨
      </p>
    </div>
  </main>
</Layout>
