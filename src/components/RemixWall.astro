---
// The club remixes its own logo constantly. Celebrate that.
const rowA = [
  { src: 'assets/remix-chrome-ice.png', alt: 'Guapøs, ice chrome serif logo', w: 800, h: 411 },
  { src: 'assets/remix-naruto-cloud.png', alt: 'Guapøs, anime cloud logo', w: 505, h: 256 },
  { src: 'assets/remix-pink.png', alt: 'Los Guapos, pink sparkle logo', w: 328, h: 199 },
  { src: 'assets/remix-metal.png', alt: 'Guapos, heavy metal chrome logo', w: 893, h: 256, invert: true },
  { src: 'assets/remix-pokemon.png', alt: 'Guapøs, pocket monster logo', w: 527, h: 256 },
  { src: 'assets/remix-gradient.png', alt: 'Guapøs, sunset gradient logo', w: 316, h: 300 },
];
const rowB = [
  { src: 'assets/remix-guapos-x-guapas.png', alt: 'Guapos x Guapas, versus logo', w: 486, h: 256 },
  { src: 'assets/perreo-y-pancakes.png', alt: 'Perreo y Pancakes', w: 450, h: 256, invert: true },
  { src: 'assets/remix-naruto.png', alt: 'Guapøs, anime swoosh logo', w: 657, h: 256 },
  { src: 'assets/wordmark-chicago.png', alt: 'Guapøs Chicago', w: 543, h: 220, invert: true },
  { src: 'assets/flaming-heart.png', alt: 'Flaming heart in an open hand', w: 500, h: 658 },
  { src: 'assets/logo-full.png', alt: 'Los Guapos globe lockup', w: 1400, h: 1095, invert: true },
];
// Even count so the -50% marquee wrap lands exactly on a copy boundary.
const REPEAT = 4;
---

<section class="relative overflow-hidden border-y border-cream/10 bg-night-soft py-24">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="neon-script text-2xl" style="font-family: var(--font-serif-display)">
      ✨The remix wall✨
    </p>
    <h2
      class="mt-2 font-display text-5xl tracking-wide uppercase sm:text-7xl"
      style="font-family: var(--font-display)"
    >
      Every Era of Guapøs
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-cream/70">
      Same familia, different disfraz. The crew reinvents the Guapøs mark for
      every run, collab, and inside joke: chrome, anime, pop, metal, perreo.
      Collect them all.
    </p>
  </div>

  <div class="mt-16 space-y-10">
    <div class="marquee-mask overflow-hidden" style="--marquee-speed: 55s">
      <div class="marquee-track items-center gap-16 pr-16">
        {
          Array.from({ length: REPEAT }).flatMap(() => rowA).map((l) => (
            <img
              src={l.src}
              alt={l.alt}
              width={l.w}
              height={l.h}
              class:list={['h-24 w-auto sm:h-32', l.invert && 'invert']}
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
    <div class="marquee-mask marquee-reverse overflow-hidden" style="--marquee-speed: 64s">
      <div class="marquee-track items-center gap-16 pr-16">
        {
          Array.from({ length: REPEAT }).flatMap(() => rowB).map((l) => (
            <img
              src={l.src}
              alt={l.alt}
              width={l.w}
              height={l.h}
              class:list={['h-24 w-auto sm:h-32', l.invert && 'invert']}
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
