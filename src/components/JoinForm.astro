---
// Custom animated interest form. Posts straight to the club's Google Form,
// so responses land in the Google Forms/Sheets backend with zero server code.
const FORM_ACTION =
  'https://docs.google.com/forms/d/e/1FAIpQLSdAxrybW7VDFiJOu5nqf-9mcoXcSA2cTFgKRgjXQl-6yqW-Uw/formResponse';
const ENTRY_NAME = 'entry.1189566523';
const ENTRY_EMAIL = 'entry.1599025857';
const ENTRY_RUNS = 'entry.232956580';
// Checkbox values must match the Google Form options exactly.
const RUN_OPTIONS = [
  { value: "Thursday Run: 6:30pm at Pilsen's Gym 🪩", label: 'Thursday Run', sub: '6:30 PM · Pilsen’s Gym', emoji: '🪩', checked: true },
  { value: 'Saturday Long Run: morning, location varies 🌤️', label: 'Saturday Long Run', sub: 'Morning · watch the story', emoji: '🌤️', checked: false },
  { value: 'Guapøtivities and special events ✨', label: 'Guapøtivities', sub: 'Themed runs y más', emoji: '✨', checked: false },
];
---

<div
  id="join-form-card"
  class="relative overflow-hidden rounded-3xl border border-cream/15 bg-black p-8 sm:p-10"
  data-action={FORM_ACTION}
  data-entry-name={ENTRY_NAME}
  data-entry-email={ENTRY_EMAIL}
  data-entry-runs={ENTRY_RUNS}
>
  <span class="sparkle text-xl" style="top: 6%; left: 88%">✦</span>
  <span class="sparkle text-sm" style="top: 85%; left: 6%; animation-delay: 1.3s">✦</span>

  {/* mile-marker progress */}
  <div class="mb-8" aria-hidden="true">
    <div class="flex justify-between font-display text-xs tracking-[0.2em] text-cream/50 uppercase" style="font-family: var(--font-display)">
      <span data-mile="0" class="mile-label text-guapo-yellow">Mile 1 · You</span>
      <span data-mile="1" class="mile-label">Mile 2 · Email</span>
      <span data-mile="2" class="mile-label">Mile 3 · Runs</span>
    </div>
    <div class="relative mt-3 h-2 rounded-full bg-cream/10">
      <div id="join-progress" class="bg-guapo-yellow absolute inset-y-0 left-0 w-1/6 rounded-full transition-all duration-500"></div>
      <span id="join-runner" class="absolute -top-3.5 left-[16%] -translate-x-1/2 text-xl transition-all duration-500">🏃🏽</span>
    </div>
  </div>

  <form id="join-form" class="flex min-h-105 flex-col" novalidate>
    {/* STEP 1: name */}
    <div class="join-step" data-step="0">
      <label
        for="jf-name"
        class="font-display block text-3xl tracking-wide text-cream uppercase sm:text-4xl"
        style="font-family: var(--font-display)"
      >
        What’s your name, Guapø?
      </label>
      <input
        id="jf-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Tu nombre ✨"
        aria-describedby="jf-name-err"
        class="focus:border-guapo-yellow aria-[invalid=true]:border-hot mt-6 w-full border-b-2 border-dotted border-cream/30 bg-transparent pb-3 text-2xl text-cream placeholder-cream/55 outline-none transition-colors"
      />
      <p id="jf-name-err" role="alert" class="join-error mt-3 hidden text-sm text-hot">Don’t be shy, we need a name to cheer for! 📣</p>
    </div>

    {/* STEP 2: email */}
    <div class="join-step hidden" data-step="1">
      <label
        for="jf-email"
        class="font-display block text-3xl tracking-wide text-cream uppercase sm:text-4xl"
        style="font-family: var(--font-display)"
      >
        Órale<span id="jf-hello"></span>. Where do we send the plans?
      </label>
      <input
        id="jf-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@email.com"
        aria-describedby="jf-email-err"
        class="focus:border-guapo-yellow aria-[invalid=true]:border-hot mt-6 w-full border-b-2 border-dotted border-cream/30 bg-transparent pb-3 text-2xl text-cream placeholder-cream/55 outline-none transition-colors"
      />
      <p class="mt-3 text-sm text-cream/60">Meetup spots and Guapøtivities only. No spam, lo prometemos.</p>
      <p id="jf-email-err" role="alert" class="join-error mt-3 hidden text-sm text-hot">Ese email no jala. Try again?</p>
    </div>

    {/* STEP 3: runs */}
    <fieldset class="join-step hidden" data-step="2">
      <legend
        class="font-display text-3xl tracking-wide text-cream uppercase sm:text-4xl"
        style="font-family: var(--font-display)"
      >
        Which runs call your name?
      </legend>
      <p class="mt-2 text-sm text-cream/50">Check all that apply. Or none, you can decide Thursday.</p>
      <div class="mt-6 space-y-3">
        {
          RUN_OPTIONS.map((o) => (
            <label class="group border-cream/15 hover:border-guapo-yellow/60 has-[:checked]:border-guapo-yellow has-[:checked]:bg-guapo-yellow/10 has-[:focus-visible]:ring-guapo-yellow flex cursor-pointer items-center gap-4 rounded-2xl border-2 p-4 transition-all has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-black">
              <input type="checkbox" name="runs" value={o.value} checked={o.checked} class="peer sr-only" />
              <span class="border-cream/40 peer-checked:border-guapo-yellow peer-checked:bg-guapo-yellow flex h-6 w-6 shrink-0 items-center justify-center rounded-md border-2 text-sm font-bold text-transparent transition-all peer-checked:text-night">
                ✓
              </span>
              <span class="grow">
                <span class="font-display block text-xl tracking-wide text-cream uppercase" style="font-family: var(--font-display)">
                  {o.label}
                </span>
                <span class="text-sm text-cream/60">{o.sub}</span>
              </span>
              <span class="w-9 text-center text-2xl leading-none transition-transform group-hover:scale-125">{o.emoji}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    {/* nav buttons */}
    <div class="mt-auto flex items-center justify-between gap-4 pt-8">
      <button
        type="button"
        id="join-back"
        class="invisible rounded-full border-2 border-cream/30 px-5 py-3 font-display tracking-wider text-cream/70 uppercase transition-colors hover:border-cream/60"
        style="font-family: var(--font-display)"
      >
        ← Back
      </button>
      <button
        type="button"
        id="join-next"
        class="bg-guapo-yellow rounded-full px-8 py-4 font-display text-lg tracking-wider text-night uppercase shadow-[0_0_30px_rgba(255,214,10,0.3)] transition-transform hover:scale-105 active:scale-95"
        style="font-family: var(--font-display)"
      >
        Vamos →
      </button>
    </div>
  </form>

  {/* success state */}
  <div id="join-success" role="status" tabindex="-1" class="hidden py-6 text-center outline-none">
    <p class="animate-spin-slow inline-block text-7xl">🪩</p>
    <p
      class="font-display mt-6 text-4xl tracking-wide text-guapo-yellow uppercase"
      style="font-family: var(--font-display)"
    >
      Nos vemos pronto!
    </p>
    <p id="join-success-msg" class="mt-4 text-lg text-cream/80">
      You’re on the list. See you Thursday, 6:30 PM at Pilsen’s Gym. ✨🪩✨
    </p>
    <a
      href="https://www.instagram.com/los._.guapos/"
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block rounded-full border-2 border-cream/40 px-6 py-3 font-display tracking-wider uppercase transition-colors hover:border-hot hover:text-hot"
      style="font-family: var(--font-display)"
    >
      Follow @los._.guapos for this week’s spot
    </a>
  </div>

  <p class="mt-6 text-center text-xs text-cream/65" id="join-fallback">
    Form being moody? <a class="underline hover:text-cream/60" href="https://docs.google.com/forms/d/e/1FAIpQLSdAxrybW7VDFiJOu5nqf-9mcoXcSA2cTFgKRgjXQl-6yqW-Uw/viewform" target="_blank" rel="noopener">Use the classic version</a>
  </p>
</div>

<style>
  @keyframes spin-slow {
    from { transform: rotate(-8deg) }
    50% { transform: rotate(8deg) }
    to { transform: rotate(-8deg) }
  }
  .animate-spin-slow {
    animation: spin-slow 2.4s ease-in-out infinite;
  }

  .join-step {
    animation: step-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes step-in {
    from { opacity: 0; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .join-shake {
    animation: shake 0.4s;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0) }
    25% { transform: translateX(-8px) }
    75% { transform: translateX(8px) }
  }

  @media (prefers-reduced-motion: reduce) {
    .join-step, .animate-spin-slow { animation: none; }
  }
</style>

{/* Confetti spans are created in JS, so their styles must be global —
    Astro's scoped styles would never match runtime-created elements. */}
<style is:global>
  .confetti {
    position: absolute;
    top: 40%;
    left: 50%;
    font-size: 1.2rem;
    pointer-events: none;
    animation: confetti-pop 1.1s ease-out forwards;
  }
  @keyframes confetti-pop {
    from { transform: translate(0, 0) scale(0.6); opacity: 1; }
    to { transform: translate(var(--dx), var(--dy)) scale(1.3) rotate(var(--rot)); opacity: 0; }
  }
</style>

<script>
  const card = document.getElementById('join-form-card');
  const form = document.getElementById('join-form');

  if (card && form) {
    const steps = [...form.querySelectorAll('.join-step')];
    const mileLabels = [...card.querySelectorAll('.mile-label')];
    const progress = document.getElementById('join-progress');
    const runner = document.getElementById('join-runner');
    const nextBtn = document.getElementById('join-next');
    const backBtn = document.getElementById('join-back');
    const success = document.getElementById('join-success');
    const successMsg = document.getElementById('join-success-msg');
    let step = 0;

    const nameInput = form.querySelector('#jf-name');
    const emailInput = form.querySelector('#jf-email');

    function render(focusInput = true) {
      steps.forEach((s, i) => s.classList.toggle('hidden', i !== step));
      mileLabels.forEach((m, i) => m.classList.toggle('text-guapo-yellow', i <= step));
      const pct = [16, 50, 84][step];
      if (progress) progress.style.width = pct + '%';
      if (runner) runner.style.left = pct + '%';
      if (backBtn) backBtn.classList.toggle('invisible', step === 0);
      if (nextBtn) nextBtn.textContent = step === 2 ? 'Count me in 🪩' : 'Vamos →';
      const hello = document.getElementById('jf-hello');
      if (hello && nameInput instanceof HTMLInputElement) {
        const first = nameInput.value.trim().split(/\s+/)[0];
        hello.textContent = first ? `, ${first}` : '';
      }
      // Never on initial mount: stealing focus on page load hijacks scroll.
      const active = steps[step].querySelector('input[type="text"], input[type="email"]');
      if (focusInput && active instanceof HTMLInputElement) {
        setTimeout(() => active.focus({ preventScroll: true }), 150);
      }
    }

    function fail(el) {
      const err = steps[step].querySelector('.join-error');
      if (err) err.classList.remove('hidden');
      steps[step].classList.add('join-shake');
      setTimeout(() => steps[step].classList.remove('join-shake'), 450);
      if (el instanceof HTMLInputElement) {
        el.setAttribute('aria-invalid', 'true');
        el.focus();
      }
    }

    function validate() {
      const err = steps[step].querySelector('.join-error');
      if (err) err.classList.add('hidden');
      steps[step].querySelectorAll('input').forEach((i) => i.removeAttribute('aria-invalid'));
      if (step === 0 && !(nameInput instanceof HTMLInputElement && nameInput.value.trim().length > 0)) {
        fail(nameInput);
        return false;
      }
      if (step === 1 && !(emailInput instanceof HTMLInputElement && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim()))) {
        fail(emailInput);
        return false;
      }
      return true;
    }

    function confetti() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const glyphs = ['✦', '✧', '🪩', '✨', '💖', '🏃🏽'];
      for (let i = 0; i < 26; i++) {
        const s = document.createElement('span');
        s.className = 'confetti';
        s.textContent = glyphs[i % glyphs.length];
        const angle = (i / 26) * Math.PI * 2;
        const dist = 90 + Math.random() * 160;
        s.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
        s.style.setProperty('--dy', Math.sin(angle) * dist - 40 + 'px');
        s.style.setProperty('--rot', (Math.random() * 360 - 180) + 'deg');
        s.style.animationDelay = Math.random() * 0.15 + 's';
        card.appendChild(s);
        setTimeout(() => s.remove(), 1400);
      }
    }

    async function submit() {
      const data = new URLSearchParams();
      data.append(card.dataset.entryName, nameInput.value.trim());
      data.append(card.dataset.entryEmail, emailInput.value.trim());
      form.querySelectorAll('input[name="runs"]:checked').forEach((c) => {
        data.append(card.dataset.entryRuns, c.value);
      });

      nextBtn.disabled = true;
      nextBtn.textContent = 'Lacing up…';
      try {
        // no-cors: Google Forms accepts the POST but the response is opaque
        await fetch(card.dataset.action, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: data.toString(),
        });
        const first = nameInput.value.trim().split(/\s+/)[0];
        if (successMsg && first) {
          successMsg.textContent = `You’re on the list, ${first}! See you Thursday, 6:30 PM at Pilsen’s Gym. ✨🪩✨`;
        }
        confetti();
        form.classList.add('hidden');
        card.querySelectorAll('[data-mile]').forEach((m) => m.classList.add('text-guapo-yellow'));
        if (progress) progress.style.width = '100%';
        if (runner) runner.style.left = '100%';
        // no-cors responses are opaque, so we can't verify receipt;
        // keep the classic-form fallback visible just in case.
        success?.classList.remove('hidden');
        if (success instanceof HTMLElement) success.focus();
      } catch {
        nextBtn.disabled = false;
        nextBtn.textContent = 'Try again →';
      }
    }

    nextBtn?.addEventListener('click', () => {
      if (!validate()) return;
      if (step < 2) {
        step++;
        render();
      } else {
        submit();
      }
    });
    backBtn?.addEventListener('click', () => {
      if (step > 0) {
        step--;
        render();
      }
    });
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target instanceof HTMLInputElement && e.target.type !== 'checkbox') {
        e.preventDefault();
        nextBtn?.click();
      }
    });
    // Implicit form submission (Enter with no submit button) also advances.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      nextBtn?.click();
    });

    render(false);
  }
</script>
